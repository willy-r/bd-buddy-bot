BOT_ENV=dev

DATABASE_PATH=db.dev.sqlite3

# Discord bot token and application ID
DISCORD_TOKEN=your-token-goes-here
DISCORD_CLIENT_ID=your-application-id-goes-here
# Public key from Developer Portal > General Information (required for HTTP interactions)
DISCORD_PUBLIC_KEY=your-public-key-goes-here
# This is necessary to deploy commands for a specific server,
# for example when developing a command and testing it on a server
DISCORD_GUILD_ID=your-server-id-goes-here

# Specific business rules from this bot
# Maps guild IDs to the role that can use birthday commands AND receives ping on announcements (JSON object)
# Example: {"GUILD_ID_1":"ROLE_ID_1","GUILD_ID_2":"ROLE_ID_2"}
BIRTHDAY_GUILD_ROLES_MAP={"123":"546"}
# Maps guild IDs to their birthday announcement channel IDs (JSON object)
# Example: {"GUILD_ID_1":"CHANNEL_ID_1","GUILD_ID_2":"CHANNEL_ID_2"}
BIRTHDAY_GUILD_CHANNELS_MAP={"123":"456"}

# Secret token to protect the internal /jobs/birthday-reminder endpoint
# Generate with: node -e "console.log(require('crypto').randomUUID())"
INTERNAL_JOB_TOKEN=your-random-uuid-here

# Used on /next command
DEFAULT_LIMIT=5
MAX_LIMIT=25
MIN_LIMIT=1
